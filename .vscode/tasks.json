{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build:cli",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "--filter",
        "@ai-team/cli",
        "build"
      ],
      "group": "build",
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "build:vscode",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "--dir",
        "packages/vscode",
        "build"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "dev:vscode",
      "type": "shell",
      "command": "pnpm",
      "args": [
        "--dir",
        "packages/vscode",
        "dev"
      ],
      "isBackground": true,
      "presentation": {
        "label": "vscode extension dev",
        "group": "dev",
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "custom",
        "pattern": {
          "regexp": "^(.*)$",
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "\\[ai-team/vscode\\] Extension watch starting",
          "endsPattern": "\\[ai-team/vscode\\] Extension watch ready"
        }
      }
    },
    {
      "label": "dev:web",
      "type": "shell",
      "command": "pnpm",
      "args": ["--filter", "@ai-team/web", "dev"],
      "isBackground": true,
      "presentation": {
        "label": "web dev",
        "group": "dev",
        "reveal": "silent",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE",
          "endsPattern": "Local:\\s+http://localhost"
        }
      }
    },
    {
      "label": "Log: Tail backend",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/tail-log.mjs"
      ],
      "isBackground": true,
      "presentation": {
        "label": "backend.log",
        "group": "logs",
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Log: Tail backend (all sources)",
      "type": "shell",
      "command": "node",
      "args": [
        "scripts/tail-log.mjs",
        "--all"
      ],
      "isBackground": true,
      "presentation": {
        "label": "backend.log (all)",
        "group": "logs",
        "reveal": "always",
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}