{
  "name": "@ai-team/api-client",
  "version": "0.1.0",
  "description": "Shared API client interface and adapters for AI Team",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-team/core": "workspace:*",
    "@ai-team/service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
