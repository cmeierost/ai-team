{
  "name": "@ai-team/api-client",
  "version": "0.1.0",
  "description": "Shared API client interface and adapters for AI Team",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json"
  },
  "type": "module",
  "scripts": {
    "build": "ts-http-openapi && tsc",
    "generate:openapi": "ts-http-openapi",
    "dev": "tsc --watch",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ts-http/core": "^0.0.5"
  },
  "devDependencies": {
    "@ts-http/openapi": "^0.0.5",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}