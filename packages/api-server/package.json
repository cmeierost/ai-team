{
  "name": "@ai-team/api-server",
  "version": "0.1.0",
  "description": "HTTP REST API server for AI Team web UI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node scripts/generate-ws-schemas.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-team/api-client": "workspace:*",
    "@ai-team/core": "workspace:*",
    "@ai-team/ide-interface": "workspace:*",
    "@ai-team/service": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@asyncapi/parser": "^3.0.14",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.16",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.5.10",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "typescript-json-schema": "^0.65.1",
    "vitest": "^1.2.2"
  }
}
