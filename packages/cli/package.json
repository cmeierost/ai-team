{
  "name": "@ai-team/cli",
  "version": "0.1.0",
  "description": "Command-line interface for AI Team management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "ai-team": "./dist/cli.js",
    "ait": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "ai",
    "team",
    "cli",
    "agents"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ai-team/api-contracts": "workspace:*",
    "@ai-team/container": "workspace:*",
    "@ai-team/core": "workspace:*",
    "@ai-team/infrastructure": "workspace:*",
    "@ai-team/service": "workspace:*",
    "@inquirer/prompts": "^8.3.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "inquirer": "^13.3.0",
    "ora": "^9.3.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.9",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}