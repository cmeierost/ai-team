{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "composite": true,
        "module": "Node16",
        "moduleResolution": "node16"
    },
    "references": [
        {
            "path": "../core"
        },
        {
            "path": "../infrastructure"
        },
        {
            "path": "../service"
        }
    ],
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts"
    ]
}