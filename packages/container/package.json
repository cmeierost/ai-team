        "@ai-team/infrastructure": "workspace:*",
        "@ai-team/service": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^25.9.0",
        "@vitest/coverage-v8": "^4.1.6",
        "typescript": "^5.9.3",
        "vitest": "^4.1.6"
    }
}