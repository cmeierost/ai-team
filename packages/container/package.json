{
    "name": "@ai-team/container",
    "version": "0.1.0",
    "description": "Dependency injection container and bootstrap helpers for AI Team runtime",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run --passWithNoTests",
