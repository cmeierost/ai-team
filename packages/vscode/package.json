{
  "name": "ai-team",
  "displayName": "AI Team",
  "description": "AI Team IDE integration — file editing, keep/undo decorations, and connection status",
  "version": "0.1.0",
  "publisher": "ai-team",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai-team.initWorkspace",
        "title": "Initialize AI Team Workspace",
        "category": "AI Team"
      },
      {
        "command": "ai-team.openWebApp",
        "title": "Open Web App",
        "category": "AI Team",
        "icon": "$(globe)"
      },
      {
        "command": "ai-team.acceptChange",
        "title": "Accept Change",
        "category": "AI Team",
        "icon": "$(check)"
      },
      {
        "command": "ai-team.rejectChange",
        "title": "Reject Change",
        "category": "AI Team",
        "icon": "$(discard)"
      },
      {
        "command": "ai-team.acceptProposal",
        "title": "Keep All",
        "category": "AI Team",
        "icon": "$(check)"
      },
      {
        "command": "ai-team.rejectProposal",
        "title": "Undo All",
        "category": "AI Team",
        "icon": "$(discard)"
      },
      {
        "command": "ai-team.showFileDiff",
        "title": "Show Diff",
        "category": "AI Team",
        "icon": "$(diff)"
      },
      {
        "command": "ai-team.showPendingChanges",
        "title": "Show Pending Changes",
        "category": "AI Team",
        "icon": "$(diff)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai-team",
          "title": "AI Team",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ai-team": [
        {
          "id": "ai-team.connectionsView",
          "name": "Connections"
        },
        {
          "id": "ai-team.pendingChangesView",
          "name": "Pending Changes"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "ai-team.openWebApp",
          "when": "view == ai-team.connectionsView",
          "group": "navigation"
        },
        {
          "command": "ai-team.showPendingChanges",
          "when": "view == ai-team.connectionsView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "ai-team.acceptProposal",
          "when": "view == ai-team.pendingChangesView && viewItem == proposal",
          "group": "inline@1"
        },
        {
          "command": "ai-team.rejectProposal",
          "when": "view == ai-team.pendingChangesView && viewItem == proposal",
          "group": "inline@2"
        },
        {
          "command": "ai-team.showFileDiff",
          "when": "view == ai-team.pendingChangesView && viewItem == pendingFile",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "title": "AI Team",
      "properties": {
        "ai-team.webAppUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL of the AI Team web app (used by the Open Web App button)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm bundle",
    "bundle": "node build.cjs",
    "build": "node build.cjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.cjs --watch",
    "reinstall": "pnpm bundle && npx @vscode/vsce package --no-dependencies --allow-missing-repository --skip-license && code --install-extension ai-team-0.1.0.vsix --force",
    "lint": "eslint src --ext .ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@ai-team/core": "workspace:*",
    "@ai-team/ide-interface": "workspace:*",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/vscode": "^1.110.0",
    "@types/node": "^25.5.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "eslint": "^10.0.3",
    "@typescript-eslint/parser": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0"
  }
}
