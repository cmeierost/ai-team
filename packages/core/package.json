    "zod": "^4.3.6",
    "zod-to-json-schema": "3.24.5"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^10.0.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2",
    "vscode-languageserver-types": "3.17.5"
  }
