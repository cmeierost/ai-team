{
  "name": "ai-team",
  "version": "0.1.0",
  "private": true,
  "description": "AI Team - AI supported software engineering without losing control",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm api:kill && pnpm dev:web",
    "dev:web": "pnpm --filter @ai-team/api-server --filter @ai-team/web --parallel dev",
    "dev:api": "pnpm --filter @ai-team/api-server dev",
    "server:start": "pnpm --filter @ai-team/api-server dev",
    "web:start": "pnpm --filter @ai-team/web dev",
    "server:kill": "kill-port 3002",
    "web:kill": "kill-port 3000",
    "api:kill": "kill-port 3002 3000",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "eslint": "^10.0.0",
    "kill-port": "^2.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
