{
  "name": "@aspect/engine",
  "version": "0.1.0",
  "description": "Technology-agnostic code analysis calculation engine — derives metrics, SOLID indicators, graph analysis from collected data",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "aspect-analyze": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "code-analysis",
    "metrics",
    "solid-principles",
    "graph-analysis"
  ],
  "license": "MIT",
  "dependencies": {
    "@aspect/collector-typescript": "workspace:*",
    "@aspect/contracts": "workspace:*",
    "graphology": "^0.25.4",
    "graphology-metrics": "^2.4.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-components": "^1.5.4",
    "graphology-graphml": "^0.5.2",
    "graphology-types": "^0.24.7",
    "ts-graphviz": "^2.1.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
